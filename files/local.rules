drop quic $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH3 bypass to public resolver dns.adguard.com"; quic.sni; dotprefix; content:".dns.adguard.com"; endswith; nocase; classtype:policy-violation; sid:9000207; rev:1;)

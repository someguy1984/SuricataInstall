drop quic $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH3 bypass to public resolver dns.nextdns.io"; quic.sni; dotprefix; content:".dns.nextdns.io"; endswith; nocase; classtype:policy-violation; sid:9000209; rev:1;)

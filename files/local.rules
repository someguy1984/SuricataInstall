# This machine's own rules. install.sh installs them as /etc/suricata/local.rules,
# where suricata-update leaves them alone. SIDs 9000000-9099999 are reserved for local use.

# No unencrypted DNS may leave this machine: ctrld resolves everything over DoH (443).
# These drop the fallback that ctrld uses when its upstream fails (leak_on_upstream_failure),
# which the DNSLOCK firewall chain lets through because it exempts ctrld's cgroup.
# Loopback (ctrld itself) never reaches NFQUEUE, and libvirt VMs talking to this machine's
# own bridge address are in HOME_NET, so neither is affected.
drop udp $HOME_NET any -> $EXTERNAL_NET 53 (msg:"LOCAL Plain DNS (UDP) leaving this machine"; classtype:policy-violation; sid:9000001; rev:1;)
drop tcp $HOME_NET any -> $EXTERNAL_NET 53 (msg:"LOCAL Plain DNS (TCP) leaving this machine"; classtype:policy-violation; sid:9000002; rev:1;)
drop tcp $HOME_NET any -> $EXTERNAL_NET 853 (msg:"LOCAL DNS-over-TLS leaving this machine (not ctrld)"; classtype:policy-violation; sid:9000003; rev:1;)
drop udp $HOME_NET any -> $EXTERNAL_NET 853 (msg:"LOCAL DNS-over-QUIC leaving this machine (not ctrld)"; classtype:policy-violation; sid:9000004; rev:1;)

# DoH bypass: apps that bring their own DNS-over-HTTPS resolver skip ctrld (and so the Control D
# profile) entirely, over ordinary port 443. Drop TLS (DoH) and QUIC (DoH3) connections whose SNI
# is a well-known public resolver; subdomains match too (dotprefix), e.g. mozilla.cloudflare-dns.com.
# ctrld's own upstream, dns.controld.com, is deliberately not listed. The dns-lockdown firewall
# (controld/) also rejects 443 to these resolvers' fixed IPs, which covers connections that hide
# their SNI (ECH). Add resolvers here as they turn up.
drop tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH bypass to public resolver dns.google"; tls.sni; dotprefix; content:".dns.google"; endswith; nocase; classtype:policy-violation; sid:9000101; rev:1;)
drop quic $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH3 bypass to public resolver dns.google"; quic.sni; dotprefix; content:".dns.google"; endswith; nocase; classtype:policy-violation; sid:9000201; rev:1;)
drop tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH bypass to public resolver cloudflare-dns.com"; tls.sni; dotprefix; content:".cloudflare-dns.com"; endswith; nocase; classtype:policy-violation; sid:9000102; rev:1;)
drop quic $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH3 bypass to public resolver cloudflare-dns.com"; quic.sni; dotprefix; content:".cloudflare-dns.com"; endswith; nocase; classtype:policy-violation; sid:9000202; rev:1;)
drop tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH bypass to public resolver one.one.one.one"; tls.sni; dotprefix; content:".one.one.one.one"; endswith; nocase; classtype:policy-violation; sid:9000103; rev:1;)
drop quic $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH3 bypass to public resolver one.one.one.one"; quic.sni; dotprefix; content:".one.one.one.one"; endswith; nocase; classtype:policy-violation; sid:9000203; rev:1;)
drop tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH bypass to public resolver quad9.net"; tls.sni; dotprefix; content:".quad9.net"; endswith; nocase; classtype:policy-violation; sid:9000104; rev:1;)
drop quic $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH3 bypass to public resolver quad9.net"; quic.sni; dotprefix; content:".quad9.net"; endswith; nocase; classtype:policy-violation; sid:9000204; rev:1;)
drop tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH bypass to public resolver doh.opendns.com"; tls.sni; dotprefix; content:".doh.opendns.com"; endswith; nocase; classtype:policy-violation; sid:9000105; rev:1;)
drop quic $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL DoH3 bypass to public resolver doh.opendns.com"; quic.sni; dotprefix; content:".doh.opendns.com"; endswith; nocase; classtype:policy-violation; sid:9000205; rev:1;)

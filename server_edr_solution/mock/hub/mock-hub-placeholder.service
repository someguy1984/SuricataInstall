# Stands in for edr-hub until it is installed: a TLS 1.3 listener on the hub port, so the private
# network, the port and TLS can be tested from the web box. `mock.sh install-hub` disables it before
# installing the real hub (systemctl disable --now mock-hub-placeholder); `mock.sh uninstall` enables it again.
[Unit]
Description=Mock: TLS placeholder for edr-hub on :8443
After=network-online.target mock-tls.service
Requires=mock-tls.service

[Service]
DynamicUser=yes
# The key is root-only: a root command (the "+") copies it into the unit's runtime directory for the dynamic user.
# (LoadCredential did this before; under rootless Docker with systemd 255, Ubuntu 24.04, the credential directory
# stays empty and the placeholder never starts.)
RuntimeDirectory=mock-hub-placeholder
ExecStartPre=+/bin/sh -c 'install -m 0400 -o "$(stat -L -c %%u /run/mock-hub-placeholder)" /etc/ssl/mock/hub.key /run/mock-hub-placeholder/hub.key'
ExecStart=/usr/bin/openssl s_server -quiet -accept 8443 -tls1_3 -www \
    -cert /etc/ssl/mock/hub.crt -key /run/mock-hub-placeholder/hub.key
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

# Shared by the :80 and :443 servers of web.dev.local.
root  /var/www/web.dev.local/public;
index index.php;

server_tokens off;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

location ~ \.php$ {
    include snippets/fastcgi-php.conf;
    fastcgi_pass unix:/run/php/php8.5-fpm.sock;
}

# never serve dotfiles (.env, .git) - the probes the EDR is meant to notice
location ~ /\.(?!well-known) {
    deny all;
}

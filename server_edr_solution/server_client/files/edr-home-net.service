# Keeps Suricata's HOME_NET equal to this machine's addresses (client PLAN section 4.1). Also run
# by the Suricata unit drop-in before each Suricata start, with --no-reload.
[Unit]
Description=Set Suricata's HOME_NET to this machine's own addresses
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/edr-agent/edr-home-net
User=root
# One capability, for one directory: the Suricata package makes /etc/suricata suricata:suricata 0750, so root
# without CAP_DAC_OVERRIDE cannot even read the old value there, and the unit failed at every timer run (first
# install with Suricata in the mock). ProtectSystem=strict and ReadWritePaths below keep the writes to that directory.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
ProtectHome=yes
SystemCallFilter=@system-service
ReadWritePaths=/etc/suricata
MemoryMax=64M
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=60
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitCORE=0
LogNamespace=edr

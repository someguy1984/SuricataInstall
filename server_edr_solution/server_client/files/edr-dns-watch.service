# The DNS lock's watchdog (client PLAN section 4.4): probes the proxy, opens the lock when DoH
# fails, closes it when healthy. It needs systemctl (to restart the proxy and resolved), so it
# keeps the netlink and unix sockets and the capabilities nft needs. Sandbox, not a jail.
[Unit]
Description=Probe the DoH proxy and open or close the DNS lock
After=nftables.service dnscrypt-proxy.socket
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/edr-agent/edr-dns-watch probe
TimeoutStartSec=30
User=root
Group=edr-agent
UMask=0027
LogNamespace=edr
Nice=19
IOSchedulingClass=idle
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
# resolved reads its drop-ins from /run/systemd/resolved.conf.d
ReadWritePaths=/run/systemd/resolved.conf.d
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_NETLINK AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RuntimeDirectory=edr-dns-watch
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=edr-dns-watch
StateDirectoryMode=0700
MemoryMax=64M
TasksMax=32
LimitCORE=0

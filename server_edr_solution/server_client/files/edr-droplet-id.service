# Reads the DigitalOcean droplet id and writes /run/edr-droplet-id for the agent (client PLAN
# section 4.6). It may reach the metadata address and nothing else, so the sandboxed agent never
# gets metadata access. Started before edr-agent.service at every boot and every start of the agent
# (no RemainAfterExit). The unit has no capability and may write one file.
[Unit]
Description=Write the droplet id for the agent
Before=edr-agent.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/edr-agent/edr-droplet-id
User=root
Group=edr-agent
UMask=0027
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=169.254.169.254
ProtectHome=yes
SystemCallFilter=@system-service
# Only the one file is writable: the unit creates it if it is missing (root, outside the sandbox) and the helper writes
# into it in place, because a bind-mounted file cannot be replaced by a rename.
ExecStartPre=+/bin/sh -c '[ -e /run/edr-droplet-id ] || install -m 0640 -o root -g edr-agent /dev/null /run/edr-droplet-id'
ReadWritePaths=/run/edr-droplet-id
MemoryMax=64M
Nice=19
TimeoutStartSec=10
TasksMax=16
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitCORE=0
LogNamespace=edr

[Install]
WantedBy=multi-user.target

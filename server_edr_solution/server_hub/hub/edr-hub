def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0 if argv else hub_common.EXIT_USAGE
    if argv[0] == "--version":
        out("edr-hub " + hub_common.VERSION)
        return 0
    handler = COMMANDS.get(argv[0])
    if handler is None:
        sys.stderr.write("edr-hub: unknown command %s\n%s" % (c(argv[0], 40), USAGE))
        return hub_common.EXIT_USAGE
    try:
        return handler(argv[1:])
    except CliError as exc:
        sys.stderr.write("edr-hub: %s\n" % c(exc.message, 400))
        return exc.code
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

def cmd_health(argv):
    Parser(prog="edr-hub health").parse_args(argv)
    problems = []
    try:
        conn = open_db()
    except CliError as exc:
        out("unhealthy: " + exc.message)
        return hub_common.EXIT_FAIL
    try:
        now = hub_common.now_ms()
        tick = meta(conn, "writer_tick")
        if tick is None or not str(tick).lstrip("-").isdigit():
            problems.append("the writer has never reported")
        elif now - int(tick) > 30_000:
            problems.append("the writer has not committed or idled for %d s" % ((now - int(tick)) // 1000))
        etick = meta(conn, "engine_tick")
        if etick is None or not str(etick).lstrip("-").isdigit():
            problems.append("the engine has never ticked")
        elif now - int(etick) > 60_000:
            problems.append("the engine has not ticked for %d s" % ((now - int(etick)) // 1000))
        cursor = meta(conn, "engine_cursor", "0")
        cursor = int(cursor) if str(cursor).isdigit() else 0
        row = conn.execute("SELECT received_at FROM events WHERE id > ? ORDER BY id LIMIT 1", (cursor,)).fetchone()
        if row is not None and now - row[0] > 60_000:
            problems.append("the engine cursor is %d s behind" % ((now - row[0]) // 1000))
    except sqlite3.Error as exc:
        problems.append("database error: " + c(exc, 80))
    finally:
        conn.close()
    if problems:
        out("unhealthy: " + "; ".join(problems))
        return hub_common.EXIT_FAIL
    out("healthy")
    return 0



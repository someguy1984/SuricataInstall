[Unit]
Description=EDR hub outbound worker: alert channels and the dead-man ping
Wants=edr-hub.service
After=edr-hub.service
OnFailure=edr-hub-failed.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
Restart=on-failure
RestartSec=5
User=edr-hub-out
Group=edr-hub-out
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/lib/edr-hub/edr_hub_out.py

# The only unit that may open outbound connections. It sees secrets.json only as a credential
# (the installer creates /etc/edr-hub/secrets.json, 0600, with {} in it; a missing file stops the unit).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LoadCredential=secrets.json:/etc/edr-hub/secrets.json
StateDirectory=edr-hub-out
StateDirectoryMode=0700
MemoryMax=128M
TasksMax=64
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=yes
KeyringMode=private
LogNamespace=edr-hub

[Install]
WantedBy=multi-user.target

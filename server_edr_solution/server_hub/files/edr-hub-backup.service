[Unit]
Description=EDR hub scheduled backup (encrypted)
After=edr-hub.service

[Service]
Type=oneshot
User=root
UMask=0077
# The audit recognises the scheduled run by the cgroup of this unit's name: do not rename it
ExecStart=/usr/local/sbin/edr-hub backup
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle

# Root, but held to what a backup needs: it reads the state directory (the CA key included), writes the
# backups and the last-backup marker, and keeps the owner and group of what it copies (hence @chown is allowed back).
# Without a capability list root could not read /var/lib/edr-hub/ca, which is 0700 edr-hub.
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
ReadWritePaths=/var/lib/edr-hub /var/backups/edr-hub
MemoryMax=512M
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
RemoveIPC=yes
KeyringMode=private
LogNamespace=edr-hub

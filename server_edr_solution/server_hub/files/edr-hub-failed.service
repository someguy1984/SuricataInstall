[Unit]
Description=EDR hub: send one message that edr-hub.service failed (OnFailure=)

[Service]
Type=oneshot
User=edr-hub-out
Group=edr-hub-out
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/lib/edr-hub/edr_hub_out.py --failed-notice

# The same credential and state directory as edr-hub-out: the channel and its options are in channels.json
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LoadCredential=secrets.json:/etc/edr-hub/secrets.json
StateDirectory=edr-hub-out
StateDirectoryMode=0700
MemoryMax=128M
TasksMax=64
TimeoutStartSec=60
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=yes
KeyringMode=private
LogNamespace=edr-hub
